# Postgres connection (Supabase in production, local Postgres in dev)
DATABASE_URL=postgres://wt:wt@localhost:5432/winetracker
# Used by the test suite; it is migrated and truncated by the tests
TEST_DATABASE_URL=postgres://wt:wt@localhost:5432/winetracker_test

# LLM provider for label reading: gemini | openrouter | none (empty = whichever key is set)
LLM_PROVIDER=
# OpenRouter: free vision models (":free"), no billing. Key from https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# Optional: put a specific model first (default: google/gemma-4-31b-it:free, then other free vision models)
OPENROUTER_MODEL=
GEMINI_API_KEY=
# Optional: put a specific Gemini model at the front of the fallback list
GEMINI_MODEL=
# Price refreshes also search the web via the LLM (Gemini: needs billing). false = known shop pages only
PRICE_WEB_SEARCH=true

# Crawler identity - sent as the User-Agent and matched against robots.txt
CRAWLER_USER_AGENT=WineTrackerBot/0.1 (+https://github.com/rdighe/WineTracker)
PORT=5050

# Auth (Supabase). Projects with JWT signing keys (the default now): set the JWKS URL,
# https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json. Legacy HS256 projects: the JWT secret.
SUPABASE_JWKS_URL=
SUPABASE_JWT_SECRET=
# Local development only: accept "Authorization: Dev <name>" (ignored in production)
ALLOW_DEV_AUTH=true

# Browser origins allowed to call the API (Expo web / local dev), comma-separated
ALLOWED_ORIGINS=http://localhost:8081

# Proxies in front of the API (Render: 1), so rate limits use the client IP
TRUST_PROXY=0
