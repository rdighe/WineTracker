  "dependencies": {
    "cheerio": "^1.2.0",
    "dotenv": "^18.0.7",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "fast-xml-parser": "^5.11.2",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "robots-parser": "^3.0.1",
