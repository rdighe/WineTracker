# WineTracker API base URL (no trailing slash). On a phone, use your computer's LAN IP, not localhost.
EXPO_PUBLIC_API_URL=http://192.168.1.10:5050
# Supabase project (sign-in). Leave empty to use the API's development sign-in (ALLOW_DEV_AUTH=true).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
