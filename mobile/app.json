{
  "expo": {
    "name": "WineTracker",
    "slug": "winetracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rohanatstanford.winetracker",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.rohanatstanford.winetracker"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "WineTracker uses the camera to read wine labels.",
          "photosPermission": "WineTracker reads wine labels from photos you choose.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F4F2",
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#0E0C0D",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "WineTracker uses your location to show wines at shops near you and shops that ship to your state. Your location is never stored.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ]
    ],
    "scheme": "winetracker",
    "experiments": {
      "typedRoutes": true
    },
    "backgroundColor": "#0E0C0D",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1af27cfa-3aa3-41bf-ba27-2f368f18fa57"
      }
    }
  }
}
